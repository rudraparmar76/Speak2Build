{
  "name": "speak2build",
  "displayName": "Speak2Build",
  "description": "Speech-to-verified-code assistant for Python projects",
  "version": "0.1.0",
  "publisher": "speak2build",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rudraparmar76/Speak2Build.git"
  },
  "homepage": "https://github.com/rudraparmar76/Speak2Build",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "speak2build",
          "title": "Speak2Build",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "speak2build": [
        {
          "type": "webview",
          "id": "speak2build.sidebar",
          "name": "Speak2Build"
        }
      ]
    },
    "commands": [
      {
        "command": "speak2build.focus",
        "title": "Speak2Build: Open Assistant",
        "category": "Speak2Build"
      },
      {
        "command": "speak2build.toggleRecording",
        "title": "Speak2Build: Toggle Voice Recording",
        "category": "Speak2Build"
      }
    ],
    "keybindings": [
      {
        "command": "speak2build.toggleRecording",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      }
    ],
    "configuration": {
      "title": "Speak2Build",
      "properties": {
        "speak2build.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the local Speak2Build backend service."
        },
        "speak2build.llmProvider": {
          "type": "string",
          "default": "custom",
          "enum": [
            "google-ai-studio",
            "groq",
            "ollama",
            "nvidia-nim",
            "openai",
            "custom"
          ],
          "enumDescriptions": [
            "Google AI Studio (Gemini) — free tier, fast, great code quality",
            "Groq Cloud — blazing fast (2-5s), generous free tier",
            "Ollama (local) — runs on your machine, no API key needed, works offline",
            "NVIDIA NIM — large models via NVIDIA API",
            "OpenAI — GPT-4o-mini, GPT-4.1, etc.",
            "Custom OpenAI-compatible endpoint"
          ],
          "description": "LLM provider for requirement extraction and code generation."
        },
        "speak2build.llmModel": {
          "type": "string",
          "default": "",
          "description": "Model name (e.g. 'gemini-2.5-flash', 'qwen3:14b', 'llama-3.3-70b-versatile'). Leave blank to use the provider's default."
        },
        "speak2build.llmApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the LLM provider. Not needed for Ollama (local)."
        },
        "speak2build.llmApiKeys": {
          "type": "object",
          "default": {},
          "description": "Stored API keys per LLM provider."
        },
        "speak2build.llmBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Custom base URL for OpenAI-compatible API. Auto-filled for known providers."
        },
        "speak2build.llmTimeout": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 600,
          "description": "LLM request timeout in seconds."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "npx @vscode/vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  },
  "icon": "media/icon-64.png"
}
